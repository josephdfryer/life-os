{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "generate": {
      "outputs": ["generated/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "ALLOWED_EMAILS",
        "ADMIN_EMAILS",
        "ANTHROPIC_API_KEY",
        "API_KEY",
        "AUTH_COOKIE_DOMAIN",
        "AUTH_SECRET",
        "AUTH_URL",
        "DATABASE_URL",
        "ENCRYPTION_KEY",
        "GOOGLE_CALENDAR_CLIENT_ID",
        "GOOGLE_CALENDAR_CLIENT_SECRET",
        "GOOGLE_CALENDAR_REDIRECT_URI",
        "GOOGLE_CALENDAR_ACCOUNT_EMAIL",
        "GOOGLE_GMAIL_CLIENT_ID",
        "GOOGLE_GMAIL_CLIENT_SECRET",
        "GOOGLE_GMAIL_REDIRECT_URI",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "NEXTAUTH_SECRET",
        "NEXTAUTH_URL",
        "NEXT_PUBLIC_PERSONS_URL",
        "NEXT_PUBLIC_PLACES_URL",
        "NEXT_PUBLIC_STUFF_URL",
        "NEXT_PUBLIC_EVENTS_URL",
        "NEXT_PUBLIC_ASSISTANT_URL",
        "LIFE_OS_COOKIE_DOMAIN",
        "OWNER_EMAILS",
        "THEORY_WORKSPACE_ID",
        "TURSO_AUTH_TOKEN",
        "TURSO_DATABASE_URL",
        "TURSO_SYNC_URL",
        "TWILIO_ACCOUNT_SID",
        "TWILIO_AUTH_TOKEN",
        "TWILIO_WHATSAPP_NUMBER",
        "MY_WHATSAPP_NUMBER",
        "LIFE_OS_WORKSPACE_ID",
        "LIFE_OS_API_URL",
        "PERSONS_API_KEY",
        "CRON_SECRET",
        "OURA_CLIENT_ID",
        "OURA_CLIENT_SECRET",
        "OURA_REDIRECT_URI",
        "OURA_WEBHOOK_CALLBACK_URL",
        "OURA_WEBHOOK_VERIFICATION_TOKEN"
        ,"FILE_STORAGE_PROVIDER"
        ,"AWS_REGION"
        ,"AWS_ROLE_ARN"
        ,"S3_BUCKET_NAME"
        ,"LIFE_OS_FILE_DIR"
        ,"FILE_INTELLIGENCE_INGESTION"
        ,"FILE_INTELLIGENCE_REVIEW_PROPOSALS"
        ,"FILE_INTELLIGENCE_SAFE_AUTO"
        ,"FILE_INTELLIGENCE_NIGHTLY_THEORY"
        ,"FILE_INTELLIGENCE_NIGHTLY_MAX_PEOPLE"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "type-check": {
      "dependsOn": ["^type-check"]
    }
  }
}
