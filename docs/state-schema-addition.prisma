// ─────────────────────────────────────────────
// STATE LAYER
// Add these two models to your existing schema.prisma
// ─────────────────────────────────────────────

// Controlled vocabulary — defines every valid state.
// Seeded once, extended manually as needed.
model StateDefinition {
  id          String  @id @default(cuid())
  workspaceId String
  entityType  String  // "Person" | "Place" | "Object" | "Event" | "Plan" | "Group"
  type        String  // see seed data below for full vocabulary
  value       String
  description String?
  states      State[]

  @@unique([workspaceId, entityType, type, value])
  @@index([workspaceId, entityType])
}

// Append-only log of state transitions.
// Never updated — only new records written.
// Duration is always derived by diffing consecutive recordedAt values
// for the same entityId + type combination.
model State {
  id           String          @id @default(cuid())
  workspaceId  String
  entityType   String          // "Person" | "Place" | "Object" | "Event" | "Plan" | "Group"
  entityId     String          // FK to the relevant node
  definitionId String
  definition   StateDefinition @relation(fields: [definitionId], references: [id])
  severity     Float?          // 0–1, optional signal strength
  source       String?         // "manual" | "healthkit" | "pipeline" | "oura"
  recordedAt   DateTime        // when this state was entered
  createdAt    DateTime        @default(now())

  @@index([workspaceId, entityId, entityType])
  @@index([workspaceId, entityId, entityType, recordedAt])
}

