{
  "name": "@life-os/db",
  "version": "0.0.1",
  "private": true,
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./crypto": "./src/crypto.ts",
    "./enrich": "./src/enrich.ts"
  },
  "scripts": {
    "build": "npm run generate",
    "generate": "prisma generate && prisma generate --schema prisma/schema.sqlite.prisma",
    "generate:postgres": "prisma generate",
    "generate:sqlite": "prisma generate --schema prisma/schema.sqlite.prisma",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:turso:wardrobe": "tsx turso-migrate-wardrobe.ts",
    "diagnose:empty-places": "tsx diagnose-empty-places.ts",
    "repair:workspace-membership": "tsx repair-workspace-membership.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.2",
    "@prisma/adapter-better-sqlite3": "*",
    "@prisma/adapter-libsql": "*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.7.0",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.4.1",
    "pg": "^8.23.0",
    "prisma": "^7.7.0"
  }
}
