// ═════════════════════════════════════════════
// LIFE OS — DATA MODEL
// Founding document: docs/MANIFESTO.md
//
// Eight primitives connected by one edge type (Interaction):
//   Person · Place · Item · Event · Plan · Group · State · Note
//
// Core rules:
//   • Derive, never store, aggregates (net worth, relationship health, attention score)
//   • Semantic honesty over convenience — never overload a primitive with flags
//   • Provenance is sacred — every derived node traces back to its source
//   • Resist new primitives hard; each one earned its place
// ═════════════════════════════════════════════

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─────────────────────────────────────────────
// TENANCY: Workspace isolation
// ─────────────────────────────────────────────

model Workspace {
  id             String              @id @default(cuid())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  name           String
  slug           String              @unique
  status         String              @default("active")
  ownerUserId    String?
  ownerUser      User?               @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  members        WorkspaceMember[]
  approvedEmails ApprovedEmail[]
  persons        Person[]
  events         Event[]
  interactions   Interaction[]
  plans          Plan[]
  places         Place[]
  placeNotes     PlaceNote[]
  groups         Group[]
  items          Item[]
  importedFiles  ImportedFile[]
  stagedItems    StagedInteraction[]
  rules          Rule[]
  ruleRuns       RuleRun[]
  apiKeys        ApiKey[]
  auditLogs      AuditLog[]
  calendarConnections  CalendarConnection[]
  calendarEventLinks   CalendarEventLink[]
  gmailConnections     GmailConnection[]
  gmailMessageLinks    GmailMessageLink[]
  importJobs           ImportJob[]
  importStagedVisits   ImportStagedVisit[]
  planExpectedPersons  PlanExpectedPerson[]

  @@index([ownerUserId])
  @@index([status])
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspaceId String
  userId      String
  role        String    @default("owner")
  status      String    @default("active")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, status])
}

model ApprovedEmail {
  id          String     @id @default(cuid())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  email       String     @unique
  status      String     @default("approved")
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  invitedById String?
  invitedBy   User?      @relation("ApprovedEmailInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([workspaceId])
  @@index([invitedById])
}

// ─────────────────────────────────────────────
// PRIMARY: Person
// ─────────────────────────────────────────────

model Person {
  id           String        @id @default(cuid())
  workspaceId  String        @default("default-workspace")
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  first        String
  last         String
  nickname     String?
  title        String?
  headline     String?
  emails       String        @default("[]")
  phones       String        @default("[]")
  birthday     String?
  closeness    Int           @default(2)
  tags         String        @default("[]")
  values       String        @default("[]")
  notes        String?
  company      String?
  location     String?
  linkedin     String?
  twitter      String?
  website      String?
  color        String?
  colorSoft    String?
  interactions Interaction[]
  stagedInteractions StagedInteraction[]
  plans        Plan[]
  expectedInPlans PlanExpectedPerson[]
  ownedItems   Item[]
  assembledBy  Assembly[]    @relation("AssembledBy")
  disassembledBy Assembly[]  @relation("DisassembledBy")
  groupMemberships PersonGroup[]
  users        User[]
  apiKeys      ApiKey[]
  auditLogs    AuditLog[]

  @@index([workspaceId, last, first])
  @@index([last, first])
  @@index([title])
  @@index([closeness])
  @@index([birthday])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// ACCESS: User, roles, permissions, and API keys
// ─────────────────────────────────────────────

model User {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  email     String    @unique
  name      String?
  image     String?
  status    String    @default("active")
  personId  String?
  person    Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)
  roles     UserRole[]
  apiKeys   ApiKey[]
  auditLogs AuditLog[]
  rules     Rule[]
  workspaceMemberships WorkspaceMember[]
  ownedWorkspaces      Workspace[]     @relation("WorkspaceOwner")
  approvedEmailsSent   ApprovedEmail[] @relation("ApprovedEmailInviter")
  calendarConnections  CalendarConnection[]
  gmailConnections     GmailConnection[]

  @@index([email])
  @@index([status])
}

model Role {
  id          String           @id @default(cuid())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  key         String           @unique
  name        String
  description String?
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  createdAt   DateTime         @default(now())
  scope       String           @unique
  description String?
  roles       RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model ApiKey {
  id            String        @id @default(cuid())
  workspaceId   String        @default("default-workspace")
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  name          String
  keyPrefix     String        @unique
  keyHash       String        @unique
  status        String        @default("active")
  expiresAt     DateTime?
  lastUsedAt    DateTime?
  createdByUserId String?
  createdByUser User?         @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  ownerPersonId String?
  ownerPerson   Person?       @relation(fields: [ownerPersonId], references: [id], onDelete: SetNull)
  scopes        ApiKeyScope[]
  auditLogs     AuditLog[]

  @@index([status])
  @@index([workspaceId])
  @@index([createdByUserId])
  @@index([ownerPersonId])
}

model ApiKeyScope {
  apiKeyId String
  scope    String
  apiKey   ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@id([apiKeyId, scope])
  @@index([scope])
}

model AuditLog {
  id         String   @id @default(cuid())
  workspaceId String? @default("default-workspace")
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  action     String
  targetType String
  targetId   String?
  actorType  String
  actorId    String?
  actorLabel String?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  apiKeyId   String?
  apiKey     ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  personId   String?
  person     Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  metadata   String?

  @@index([createdAt])
  @@index([workspaceId, createdAt])
  @@index([action])
  @@index([targetType, targetId])
  @@index([actorType, actorId])
  @@index([userId])
  @@index([apiKeyId])
  @@index([personId])
}

// ─────────────────────────────────────────────
// INTEGRATIONS: Google Calendar
// ─────────────────────────────────────────────

model CalendarConnection {
  id              String   @id @default(cuid())
  workspaceId     String   @default("default-workspace")
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  provider        String   @default("google")
  status          String   @default("active")
  accountEmail    String?
  calendarId      String   @default("primary")
  calendarSummary String?
  accessToken     String?
  refreshToken    String?
  expiresAt       DateTime?
  scope           String?
  syncToken       String?
  lastSyncedAt    DateTime?
  lastError       String?
  eventLinks      CalendarEventLink[]

  @@unique([workspaceId, provider, calendarId])
  @@index([userId])
  @@index([workspaceId, status])
}

model CalendarEventLink {
  id             String   @id @default(cuid())
  workspaceId    String   @default("default-workspace")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId   String
  connection     CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  provider       String   @default("google")
  calendarId     String
  externalEventId String
  iCalUID        String?
  eventId        String?
  event          Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  status         String   @default("active")
  lastSeenAt     DateTime?

  @@unique([workspaceId, provider, calendarId, externalEventId])
  @@index([connectionId])
  @@index([eventId])
  @@index([workspaceId, status])
}

// ─────────────────────────────────────────────
// INTEGRATIONS: Gmail
// ─────────────────────────────────────────────

model GmailConnection {
  id             String   @id @default(cuid())
  workspaceId    String   @default("default-workspace")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  provider       String   @default("google")
  status         String   @default("active")
  accountEmail   String?
  mailboxId      String   @default("me")
  accessToken    String?
  refreshToken   String?
  expiresAt      DateTime?
  scope          String?
  historyId      String?
  lastSyncedAt   DateTime?
  lastError      String?
  messageLinks   GmailMessageLink[]

  @@unique([workspaceId, provider, mailboxId])
  @@index([userId])
  @@index([workspaceId, status])
}

model GmailMessageLink {
  id              String   @id @default(cuid())
  workspaceId     String   @default("default-workspace")
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId    String
  connection      GmailConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  provider        String   @default("google")
  mailboxId       String
  externalMessageId String
  threadId        String?
  historyId       String?
  interactionId   String?
  interaction     Interaction? @relation(fields: [interactionId], references: [id], onDelete: SetNull)
  stagedItemId    String?
  stagedItem      StagedInteraction? @relation(fields: [stagedItemId], references: [id], onDelete: SetNull)
  status          String   @default("active")
  lastSeenAt      DateTime?

  @@unique([workspaceId, provider, mailboxId, externalMessageId])
  @@index([connectionId])
  @@index([interactionId])
  @@index([stagedItemId])
  @@index([workspaceId, status])
}

// ─────────────────────────────────────────────
// RULES: deterministic policy and enrichment engine
// ─────────────────────────────────────────────

model Rule {
  id              String    @id @default(cuid())
  workspaceId     String    @default("default-workspace")
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  name            String
  description     String?
  trigger         String
  status          String    @default("active")
  priority        Int       @default(100)
  mode            String    @default("suggest")
  conditions      String    @default("[]")
  actions         String    @default("[]")
  stopProcessing  Boolean   @default(false)
  createdByUserId String?
  createdByUser   User?     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  runs            RuleRun[]

  @@index([workspaceId, trigger, status, priority])
  @@index([trigger, status, priority])
  @@index([createdByUserId])
}

model RuleRun {
  id             String   @id @default(cuid())
  workspaceId    String   @default("default-workspace")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  ruleId         String
  rule           Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  trigger        String
  targetType     String?
  targetId       String?
  matched        Boolean
  mode           String
  status         String
  input          String?
  actionsPlanned String?
  actionsApplied String?
  message        String?

  @@index([ruleId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([trigger, createdAt])
  @@index([matched, createdAt])
  @@index([targetType, targetId])
}

// ─────────────────────────────────────────────
// SUPPORT: StagedInteraction
// Universal review queue — any source can stage records here before they
// become canonical data. itemType identifies what will be created on accept.
// ─────────────────────────────────────────────

model StagedInteraction {
  id                String   @id @default(cuid())
  workspaceId        String   @default("default-workspace")
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  source            String
  sourceId          String
  itemType          String   @default("interaction")
  status            String   @default("pending")
  contactName       String?
  contactEmail      String?
  contactPhone      String?
  candidatePersonId String?
  candidatePerson   Person?  @relation(fields: [candidatePersonId], references: [id], onDelete: SetNull)
  confidence        Float?
  matchReason       String?
  type              String   @default("message")
  timestamp         DateTime
  summary           String?
  body              String?
  direction         String?
  metadata          String?
  acceptedAt        DateTime?
  acceptedPersonId  String?
  interactionId     String?
  priority          Int       @default(3)
  enrichedAt        DateTime?
  gmailLinks        GmailMessageLink[]

  @@unique([workspaceId, source, sourceId])
  @@index([status, priority, createdAt])
  @@index([source, itemType, createdAt])
  @@index([candidatePersonId])
  @@index([timestamp])
}

// ─────────────────────────────────────────────
// PRIMARY: Event
// ─────────────────────────────────────────────

model Event {
  id            String        @id @default(cuid())
  workspaceId   String        @default("default-workspace")
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  name          String
  type          String
  // start/end are the canonical time bounds; timestamp mirrors start for Persons compatibility
  start         DateTime
  end           DateTime?
  timestamp     DateTime
  placeId       String?
  place         Place?        @relation(fields: [placeId], references: [id])
  notes         String?
  transcript    String?
  metadata      String?
  // Which prediction (if any) this occurrence fulfilled
  sourcePlanId  String?
  sourcePlan    Plan?         @relation("PlanFulfillment", fields: [sourcePlanId], references: [id], onDelete: SetNull)
  // Containment nesting — bind to the narrowest true event
  parentEventId String?
  parentEvent   Event?        @relation("EventNesting", fields: [parentEventId], references: [id], onDelete: SetNull)
  childEvents   Event[]       @relation("EventNesting")
  interactions  Interaction[]
  calendarLinks CalendarEventLink[]
  groupTags     Group[]             @relation("EventGroupTags")
  placeNotes    PlaceNote[]

  @@index([workspaceId, start])
  @@index([workspaceId, timestamp])
  @@index([sourcePlanId])
  @@index([parentEventId])
}

// ─────────────────────────────────────────────
// PRIMARY: Interaction (universal linker)
// ─────────────────────────────────────────────

model Interaction {
  id              String            @id @default(cuid())
  workspaceId     String            @default("default-workspace")
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt       DateTime          @default(now())
  // Person is optional — interactions can involve any combination of primaries
  personId        String?
  person          Person?           @relation(fields: [personId], references: [id], onDelete: Cascade)
  eventId         String?
  event           Event?            @relation(fields: [eventId], references: [id])
  // Context place (where this interaction happened)
  placeId         String?
  place           Place?            @relation(fields: [placeId], references: [id])
  type            String
  timestamp       DateTime
  duration        Int?
  emotionalWeight String?
  outcome         String?
  summary         String?
  notes           String?
  actionItems     String?
  billable        Boolean           @default(false)
  amount          Float?
  direction       String?
  sourceFileId    String?
  sourceFile      ImportedFile?     @relation(fields: [sourceFileId], references: [id])
  itemInteractions ItemInteraction[]
  gmailLinks       GmailMessageLink[]

  @@index([personId, timestamp(sort: Desc)])
  @@index([workspaceId, timestamp(sort: Desc)])
  @@index([timestamp(sort: Desc)])
  @@index([placeId])
}

// ─────────────────────────────────────────────
// PRIMARY: Plan
// ─────────────────────────────────────────────

model Plan {
  id             String   @id @default(cuid())
  workspaceId    String   @default("default-workspace")
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  personId       String?
  person         Person?  @relation(fields: [personId], references: [id], onDelete: Cascade)
  text           String
  timescale      String?
  successSignals String?
  status         String   @default("active")
  parentId       String?
  children       Plan[]   @relation("PlanHierarchy")
  parent         Plan?    @relation("PlanHierarchy", fields: [parentId], references: [id])
  // Calendar-backed prediction fields (null = goal-type plan, set = temporal prediction)
  scheduledStart     DateTime?
  scheduledEnd       DateTime?
  placeId            String?
  place              Place?    @relation(fields: [placeId], references: [id])
  externalSource     String?
  externalInstanceId String?   @unique
  expectedPeople     PlanExpectedPerson[]
  // Reverse of Event.sourcePlanId — a fulfilled Plan has exactly one Event here
  fulfilledBy        Event[]   @relation("PlanFulfillment")

  @@index([workspaceId, createdAt])
  @@index([workspaceId, personId])
  @@index([workspaceId, scheduledStart])
  @@index([externalInstanceId])
}

// Junction: expected attendees on a Plan (flat Person refs, not Interactions)
model PlanExpectedPerson {
  planId      String
  personId    String
  workspaceId String   @default("default-workspace")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan        Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  person      Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([planId, personId])
  @@index([personId])
  @@index([workspaceId])
}

// ─────────────────────────────────────────────
// PRIMARY: Place (hierarchical locations)
// ─────────────────────────────────────────────

model Place {
  id            String        @id @default(cuid())
  workspaceId   String        @default("default-workspace")
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  googlePlaceId String?       @unique
  type          String?
  address       String?
  coordinates   String?
  meaning       String?
  favorite      Boolean       @default(false)
  // Self-referencing hierarchy: Earth → Country → City → Home → Room → Shelf
  parentPlaceId String?
  parentPlace   Place?        @relation("PlaceHierarchy", fields: [parentPlaceId], references: [id])
  childPlaces   Place[]       @relation("PlaceHierarchy")
  events        Event[]
  plans         Plan[]
  interactions  Interaction[]
  items         Item[]
  notes         PlaceNote[]
  groupAffiliations PlaceGroup[]
  importStagedVisits ImportStagedVisit[]

  @@index([parentPlaceId])
  @@index([workspaceId])
}

// ─────────────────────────────────────────────
// INTEGRATIONS: Google Maps Takeout import
// ─────────────────────────────────────────────

model ImportJob {
  id            String          @id @default(cuid())
  workspaceId   String
  status        ImportJobStatus @default(pending)
  format        String
  filename      String
  rawData       String?
  totalRows     Int             @default(0)
  processedRows Int             @default(0)
  createdRows   Int             @default(0)
  stagedRows    Int             @default(0)
  skippedRows   Int             @default(0)
  errorRows     Int             @default(0)
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime        @default(now())

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stagedVisits  ImportStagedVisit[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, status])
}

enum ImportJobStatus {
  pending
  running
  done
  failed
}

model ImportStagedVisit {
  id              String            @id @default(cuid())
  importJobId     String
  workspaceId     String
  rawData         Json
  placeName       String?
  placeAddress    String?
  latitude        Float?
  longitude       Float?
  googlePlaceId   String?
  startedAt       DateTime
  endedAt         DateTime?
  confidence      Float
  aiEnrichment    Json?
  status          StagedVisitStatus @default(pending)
  resolvedPlaceId String?
  resolvedEventId String?
  createdAt       DateTime          @default(now())

  importJob       ImportJob         @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  resolvedPlace   Place?            @relation(fields: [resolvedPlaceId], references: [id], onDelete: SetNull)

  @@index([importJobId, status, confidence])
  @@index([workspaceId, status, startedAt])
  @@index([googlePlaceId])
}

enum StagedVisitStatus {
  pending
  accepted
  rejected
}

model PlaceNote {
  id          String    @id @default(cuid())
  placeId     String
  workspaceId String
  body        String
  eventId     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  place       Place     @relation(fields: [placeId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  event       Event?    @relation(fields: [eventId], references: [id])

  @@index([placeId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([eventId])
}

// ─────────────────────────────────────────────
// PRIMARY: Item (Object — anything physical you own)
// ─────────────────────────────────────────────

model Item {
  id               String           @id @default(cuid())
  workspaceId      String           @default("default-workspace")
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  name             String
  description      String?
  category         String?
  make             String?
  model            String?
  serialNumber     String?
  // Auto-generated QR-printable identifier e.g. "#001-042"
  assetId          String           @unique
  quantity         Float            @default(1)

  // Acquisition
  purchaseDate     DateTime?
  purchasePrice    Float?
  purchaseFrom     String?

  // Warranty
  warrantyExpires  DateTime?
  lifetimeWarranty Boolean          @default(false)
  warrantyDetails  String?

  // Direct location — null when assembled inside another item (location is inherited)
  placeId          String?
  place            Place?           @relation(fields: [placeId], references: [id])

  // Owner
  ownedById        String?
  ownedBy          Person?          @relation(fields: [ownedById], references: [id])

  // Assembly tree
  assembledInto    Assembly[]       @relation("ChildItem")   // this item is inside something
  components       Assembly[]       @relation("ParentItem")  // things currently inside this item

  itemInteractions ItemInteraction[]

  tags             String?
  notes            String?
  color            String?
  colorSoft        String?

  @@index([name])
  @@index([category])
  @@index([assetId])
  @@index([placeId])
  @@index([ownedById])
  @@index([createdAt])
  @@index([workspaceId])
}

// ─────────────────────────────────────────────
// STRUCTURAL: Assembly
// Records that one item is (or was) inside another.
// disassembledAt = null means currently installed.
// ─────────────────────────────────────────────

model Assembly {
  id               String    @id @default(cuid())
  createdAt        DateTime  @default(now())

  childItemId      String
  childItem        Item      @relation("ChildItem",      fields: [childItemId],      references: [id])

  parentItemId     String
  parentItem       Item      @relation("ParentItem",     fields: [parentItemId],     references: [id])

  assembledAt      DateTime  @default(now())
  assembledById    String?
  assembledBy      Person?   @relation("AssembledBy",    fields: [assembledById],    references: [id])

  // null = currently installed; set when item is removed
  disassembledAt   DateTime?
  disassembledById String?
  disassembledBy   Person?   @relation("DisassembledBy", fields: [disassembledById], references: [id])

  notes            String?

  @@index([childItemId])
  @@index([parentItemId])
  @@index([disassembledAt])
}

// ─────────────────────────────────────────────
// JUNCTION: ItemInteraction (Item ↔ Interaction M:M)
// ─────────────────────────────────────────────

model ItemInteraction {
  itemId        String
  item          Item        @relation(fields: [itemId],        references: [id], onDelete: Cascade)
  interactionId String
  interaction   Interaction @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  role          String?     // "subject", "target", "context" — optional semantic hint

  @@id([itemId, interactionId])
}

// ─────────────────────────────────────────────
// SUPPORT: ImportedFile
// ─────────────────────────────────────────────

model ImportedFile {
  id           String        @id @default(cuid())
  workspaceId  String        @default("default-workspace")
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  filename     String
  format       String
  filePath     String
  sizeBytes    Int
  content      String?
  interactions Interaction[]

  @@index([workspaceId, createdAt])
}

// ─────────────────────────────────────────────
// PRIMARY: Group (6th primitive)
// Represents organizations, families, teams — any collective identity.
// Person represents humans ONLY; Group is the node for collective entities.
// ─────────────────────────────────────────────

enum GroupType {
  family
  employer
  friend_group
  sports_team
  corporation
  community
  other
}

enum PlaceGroupRelationshipType {
  corporate_parent
  employer_location
  home_venue
  residence
  usual_spot
  other
}

model Group {
  id              String    @id @default(cuid())
  workspaceId     String    @default("default-workspace")
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name            String
  groupType       GroupType
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  personMembers     PersonGroup[]
  childGroups       GroupGroup[]  @relation("ParentGroup")
  parentGroups      GroupGroup[]  @relation("ChildGroup")
  placeAffiliations PlaceGroup[]
  taggedEvents      Event[]       @relation("EventGroupTags")

  @@index([workspaceId])
  @@index([workspaceId, groupType])
}

model PersonGroup {
  id        String    @id @default(cuid())
  personId  String
  groupId   String
  role      String?
  startDate DateTime?
  endDate   DateTime?

  person    Person    @relation(fields: [personId], references: [id])
  group     Group     @relation(fields: [groupId], references: [id])

  @@index([personId])
  @@index([groupId])
}

model GroupGroup {
  id            String    @id @default(cuid())
  parentGroupId String
  childGroupId  String
  role          String?
  startDate     DateTime?
  endDate       DateTime?

  parent        Group     @relation("ParentGroup", fields: [parentGroupId], references: [id])
  child         Group     @relation("ChildGroup", fields: [childGroupId], references: [id])

  @@index([parentGroupId])
  @@index([childGroupId])
}

model PlaceGroup {
  id               String                    @id @default(cuid())
  placeId          String
  groupId          String
  relationshipType PlaceGroupRelationshipType
  startDate        DateTime?
  endDate          DateTime?

  place            Place                     @relation(fields: [placeId], references: [id])
  group            Group                     @relation(fields: [groupId], references: [id])

  @@index([placeId])
  @@index([groupId])
}

// ─────────────────────────────────────────────
// STATE LAYER
// ─────────────────────────────────────────────

model StateDefinition {
  id          String  @id @default(cuid())
  workspaceId String
  entityType  String
  type        String
  value       String
  description String?
  states      State[]

  @@unique([workspaceId, entityType, type, value])
  @@index([workspaceId, entityType])
}

model State {
  id           String          @id @default(cuid())
  workspaceId  String
  entityType   String
  entityId     String
  definitionId String
  definition   StateDefinition @relation(fields: [definitionId], references: [id])
  severity     Float?
  source       String?
  recordedAt   DateTime
  createdAt    DateTime        @default(now())

  @@index([workspaceId, entityId, entityType])
  @@index([workspaceId, entityId, entityType, recordedAt])
}
