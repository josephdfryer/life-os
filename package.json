{
  "name": "life-os",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "agent:start": "node scripts/agent-sync.mjs start",
    "agent:finish": "node scripts/agent-sync.mjs finish",
    "agent:status": "node scripts/agent-sync.mjs status",
    "imessage:sync": "tsx scripts/imessage-sync.ts",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check"
  },
  "packageManager": "npm@11.12.1",
  "devDependencies": {
    "turbo": "latest"
  }
}
