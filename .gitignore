# Turbo
.turbo

# Node
node_modules
.npm

# Next.js
.next
out

# Build outputs
dist
*.tsbuildinfo
playwright-report/
test-results/
.build/
.swiftpm/
xcuserdata/

# Env files
.env
.env*
.env.local
.env*.local

# DB files
*.db
*.db-shm
*.db-wal

# Uploads (may contain sensitive content)
apps/*/uploads/

# Claude Code local settings and worktrees
.claude/settings.local.json
.claude/worktrees/

# Local cross-agent state for Claude Code / Codex handoffs
.agent-sync/

# OS
.DS_Store

# Root-level package-lock is the single source of truth for the workspace;
# apps/persons predates the monorepo lockfile and must not regenerate its own.
apps/persons/package-lock.json

# Vercel CLI link caches for individual apps (recreated by `vercel link`).
# The repo-root .vercel/project.json is the exception: it is deliberately
# committed so every developer's Vercel CLI links to the same project
# without manual setup. Do not add it to this ignore rule — see
# docs/DEPLOY_RUNBOOK.md.
apps/*/.vercel
.vercel/*
!.vercel/project.json

# Personal data / runtime outputs (not for version control)
archive/
backups/
briefs/
capture/
logs/

# design-sync (staged scripts + build output; durable inputs under .design-sync/ ARE committed)
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
